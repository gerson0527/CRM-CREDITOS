# ============================================================
# DATABASE (PostgreSQL local)
# ============================================================
DATABASE_URL=postgresql://postgres@localhost:5432/credilibranzasjg

# ============================================================
# STORAGE (S3-compatible) — agnóstico al proveedor
# ============================================================
# AWS S3:
#   STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
#   STORAGE_REGION=us-east-1
# Cloudflare R2:
#   STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
# MinIO local:
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_REGION=us-east-1
#   STORAGE_FORCE_PATH_STYLE=true
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=creditos
# Para MinIO / Backblaze B2 / R2 con path-style:
STORAGE_FORCE_PATH_STYLE=false

# Tamaño máximo por archivo (MB) — aplicado en cliente y servidor
STORAGE_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_STORAGE_MAX_FILE_SIZE_MB=10

# ============================================================
# SESSION (auth propia)
# ============================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiame-en-produccion-32-bytes-random-hex

# ============================================================
# SUPABASE (solo legacy, ya no se usa para auth)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder